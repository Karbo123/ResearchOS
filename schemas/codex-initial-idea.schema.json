{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex initial research idea extraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "research_question", "domain", "keywords"],
  "properties": {
    "title": {"type": ["string", "null"], "maxLength": 240},
    "research_question": {"type": ["string", "null"]},
    "domain": {"type": ["string", "null"]},
    "keywords": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
