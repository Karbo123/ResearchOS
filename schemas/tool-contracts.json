{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research OS high-level tool contracts",
  "description": "Only parameter-limited high-level operations may be exposed to Mastra Agents. Commands, SQL, arbitrary paths, executables and network targets are absent.",
  "tools": [
    {"name":"clarify_research_idea","endpoint":"POST /api/chat","status":"implemented","input":{"$ref":"#/$defs/chatRequest"}},
    {"name":"create_research_project","endpoint":"POST /api/projects","status":"implemented","approval":"explicit Idea confirmation"},
    {"name":"search_literature_metadata","endpoint":"POST /api/search","status":"implemented-limited","evidence_status":"metadata_candidates_only"},
    {"name":"ingest_open_pdf_evidence","endpoint":"POST /api/projects/{project_id}/evidence/ingest","status":"implemented-limited","evidence_status":"page_quote_candidate"},
    {"name":"generate_topic_plan","endpoint":"POST /api/projects/{project_id}/experiment-plan","status":"implemented-approval-gated"},
    {"name":"submit_approved_experiment","endpoint":"POST /api/experiments","status":"implemented","input":{"$ref":"#/$defs/experimentRequest"}},
    {"name":"cancel_experiment","endpoint":"POST /api/experiments/{run_id}/cancel","status":"implemented"},
    {"name":"generate_evidence_paper_draft","endpoint":"POST /api/projects/{project_id}/paper-draft","status":"implemented-approval-gated"},
    {"name":"compile_reviewed_latex","endpoint":"POST /api/projects/{project_id}/compile-plan","status":"implemented-approval-gated"},
    {"name":"update_project_policy","endpoint":"POST /api/policies","status":"implemented-approval-gated"},
    {"name":"generate_local_report","endpoint":"POST /api/reports","status":"implemented"}
  ],
  "$defs": {
    "chatRequest": {
      "type":"object",
      "required":["message"],
      "properties": {
        "session_id":{"type":["string","null"],"format":"uuid"},
        "project_id":{"type":["string","null"],"format":"uuid"},
        "message":{"type":"string","minLength":1,"maxLength":20000},
        "attachments":{"type":"array","maxItems":50},
        "clarification_mode":{"enum":["automatic","detailed"],"default":"automatic"}
      },
      "additionalProperties":false
    },
    "experimentRequest": {
      "type":"object",
      "required":["project_id","proposal_id","experiment_type"],
      "properties": {
        "project_id":{"type":"string","format":"uuid"},
        "proposal_id":{"type":"string","format":"uuid"},
        "experiment_type":{"enum":["topic_specific","compile_latex","python_analysis","cpp_cmake","gpu_python"]},
        "execution_backend":{"enum":["windows","wsl2"],"default":"windows"},
        "config":{"type":"object","propertyNames":{"not":{"enum":["command","cmd","shell","cwd","path","url","image","network","environment"]}}},
        "random_seeds":{"type":"array","minItems":1,"maxItems":10,"items":{"type":"integer"}},
        "topic_plan":{"type":["object","null"]},
        "topic_resume":{"type":["object","null"]}
      },
      "additionalProperties":false
    }
  }
}
