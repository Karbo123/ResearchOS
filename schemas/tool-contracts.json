{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research OS high-level tool contracts",
  "description": "Only these parameter-limited tools may be exposed to an Agent. Arbitrary shell, SQL, paths and URLs are deliberately absent.",
  "tools": [
    {"name":"clarify_research_idea","status":"implemented","endpoint":"POST /api/chat","input":{"type":"object","required":["message"],"properties":{"session_id":{"type":["string","null"],"format":"uuid"},"message":{"type":"string","minLength":1,"maxLength":20000},"attachments":{"type":"array","items":{"$ref":"#/$defs/attachment"}},"clarification_mode":{"type":"string","enum":["automatic","detailed"],"default":"automatic"}},"additionalProperties":false},"output":{"$ref":"#/$defs/chatResponse"}},
    {"name":"create_research_project","status":"implemented","endpoint":"POST /api/projects","input":{"type":"object","required":["session_id","confirmed"],"properties":{"session_id":{"type":"string","format":"uuid"},"confirmed":{"const":true}},"additionalProperties":false},"output":{"type":"object","required":["project","session_id","next_action"]}},
    {"name":"evaluate_novelty_and_feasibility","status":"implemented-evidence-coverage","endpoint":"GET /api/projects/{project_id}/novelty","input":{"$ref":"#/$defs/projectId"},"output":{"type":"object","required":["assessment","verified_paper_count","fulltext_evidence_count","related_work","coverage","research_gap_candidates","duplicate_candidates","claim_gate"]}},
    {"name":"configure_model_settings","status":"implemented-local-runtime","endpoint":"GET/PUT /api/settings/models","input":{"type":"object","required":["simple","medium","complex"],"properties":{"simple":{"$ref":"#/$defs/modelTier"},"medium":{"$ref":"#/$defs/modelTier"},"complex":{"$ref":"#/$defs/modelTier"}},"additionalProperties":false},"output":{"type":"object","required":["provider","tiers"],"properties":{"provider":{"const":"openai"},"tiers":{"type":"object"}}}},
    {"name":"search_papers_and_bibtex","status":"implemented","endpoint":"POST /api/search","input":{"type":"object","required":["project_id"],"properties":{"project_id":{"type":"string","format":"uuid"},"query":{"type":["string","null"],"maxLength":500},"limit":{"type":"integer","minimum":1,"maximum":30}},"additionalProperties":false},"output":{"type":"object","required":["query","new_records","paper_ids","note"]}},
    {"name":"find_official_code_repository","status":"implemented","endpoint":"POST /api/projects/{project_id}/repositories/{repository_id}/verify","input":{"type":"object","required":["project_id","repository_id"],"properties":{"project_id":{"type":"string","format":"uuid"},"repository_id":{"type":"string","format":"uuid"}},"additionalProperties":false},"output":{"type":"object","required":["id","source_url","license_spdx","commit_or_tag","verified_official","metadata"],"properties":{"id":{"type":"string","format":"uuid"},"source_url":{"type":"string","format":"uri"},"license_spdx":{"type":["string","null"]},"commit_or_tag":{"type":["string","null"]},"verified_official":{"type":"boolean"},"metadata":{"type":"object"}}}},
    {"name":"download_open_source_code","status":"implemented-approval-gated","endpoint":"POST /api/projects/{project_id}/repositories/{repository_id}/download","approval_endpoint":"POST /api/proposals/{proposal_id}/decision","input":{"type":"object","required":["project_id","repository_id"],"properties":{"project_id":{"type":"string","format":"uuid"},"repository_id":{"type":"string","format":"uuid"}},"additionalProperties":false},"output":{"type":"object","required":["proposal_id","status"],"properties":{"proposal_id":{"type":"string","format":"uuid"},"status":{"const":"pending"}}}},
    {"name":"retrieve_citation_evidence","status":"implemented-open-pdf","endpoint":"POST /api/projects/{project_id}/evidence/ingest","input":{"type":"object","required":["project_id"],"properties":{"project_id":{"type":"string","format":"uuid"},"limit":{"type":"integer","minimum":1,"maximum":10}},"additionalProperties":false},"output":{"type":"object","required":["stored_count","evidence","errors","claim_gate"],"properties":{"stored_count":{"type":"integer"},"evidence":{"type":"array","items":{"type":"object","required":["evidence_id","paper_id","claim","quote","locator","source_url","pdf_sha256","pdf_artifact_id","bibtex"]}},"errors":{"type":"array"},"claim_gate":{"type":"string"}}}},
    {"name":"generate_experiment_plan","status":"implemented-topic-specific-approval-gated","endpoint":"POST /api/projects/{project_id}/experiment-plan","input":{"$ref":"#/$defs/projectId"},"output":{"allOf":[{"$ref":"#/$defs/pendingProposal"},{"type":"object","required":["plan","impact"],"properties":{"plan":{"$ref":"#/$defs/experimentPlan"},"impact":{"type":"object"}}}]}},
    {"name":"generate_evidence_grounded_paper","status":"implemented-approval-gated-evidence-only","endpoint":"POST /api/projects/{project_id}/paper-draft","approval_endpoint":"POST /api/proposals/{proposal_id}/decision","input":{"$ref":"#/$defs/projectId"},"output":{"allOf":[{"$ref":"#/$defs/pendingProposal"},{"type":"object","required":["impact"],"properties":{"impact":{"type":"object","required":["evidence_grounded","idea_version","evidence_ids"],"properties":{"evidence_grounded":{"const":true},"idea_version":{"type":"integer","minimum":1},"evidence_ids":{"type":"array","minItems":1,"items":{"type":"string","format":"uuid"}},"claim_map":{"type":"object"}},"additionalProperties":false}}}]}},
    {"name":"submit_experiment","status":"implemented","endpoint":"POST /api/experiments","input":{"$ref":"#/$defs/experimentRequest"},"output":{"type":"object","required":["run_id","status"]}},
    {"name":"rerun_experiment_from_checkpoint","status":"implemented-approval-gated-auto-submit","endpoint":"POST /api/projects/{project_id}/checkpoints/{checkpoint_id}/rerun","approval_endpoint":"POST /api/proposals/{proposal_id}/decision","input":{"type":"object","required":["project_id","checkpoint_id","reason"],"properties":{"project_id":{"type":"string","format":"uuid"},"checkpoint_id":{"type":"string","format":"uuid"},"reason":{"type":"string","minLength":5,"maxLength":2000}},"additionalProperties":false},"output":{"type":"object","required":["proposal_id","status","payload","impact"],"properties":{"proposal_id":{"type":"string","format":"uuid"},"status":{"const":"pending"},"payload":{"type":"object"},"impact":{"type":"object"}}}},
    {"name":"query_experiment_status","status":"implemented","endpoint":"POST /api/experiments/{run_id}/sync","input":{"type":"object","required":["run_id"],"properties":{"run_id":{"type":"string","format":"uuid"}},"additionalProperties":false},"output":{"$ref":"#/$defs/runStatus"}},
    {"name":"read_metrics","status":"implemented","endpoint":"GET /api/projects/{project_id}","input":{"$ref":"#/$defs/projectId"},"output":{"type":"object","required":["experiments"]}},
    {"name":"collect_visual_artifacts","status":"implemented","endpoint":"GET /api/projects/{project_id}","input":{"$ref":"#/$defs/projectId"},"output":{"type":"object","required":["artifacts"]}},
    {"name":"render_point_cloud_preview","status":"implemented-in-runner","input":{"type":"object","required":["project_id","proposal_id","experiment_type","random_seeds"],"properties":{"project_id":{"type":"string","format":"uuid"},"proposal_id":{"type":"string","format":"uuid"},"experiment_type":{"const":"point_cloud_demo"},"config":{"type":"object","propertyNames":{"not":{"enum":["command","cmd","shell","cwd","path"]}}},"random_seeds":{"type":"array","minItems":1,"maxItems":10,"items":{"type":"integer"}}},"additionalProperties":false},"output":{"$ref":"#/$defs/runStatus"}},
    {"name":"propose_code_patch","status":"implemented-approval-gated-isolated","endpoint":"POST /api/projects/{project_id}/patch-proposals","approval_endpoint":"POST /api/proposals/{proposal_id}/decision","input":{"type":"object","required":["project_id","patch_kind","base_git_commit","reason","summary","operations"],"properties":{"project_id":{"type":"string","format":"uuid"},"patch_kind":{"enum":["code","config","latex"]},"base_git_commit":{"type":"string","pattern":"^[0-9a-fA-F]{40}$"},"reason":{"type":"string","minLength":5,"maxLength":2000},"summary":{"type":"string","minLength":5,"maxLength":2000},"operations":{"type":"array","minItems":1,"maxItems":50,"items":{"$ref":"#/$defs/patchOperation"}}},"additionalProperties":false},"output":{"$ref":"#/$defs/pendingProposal"}},
    {"name":"rollback_project_patch","status":"implemented-approval-gated","endpoint":"POST /api/proposals/{proposal_id}/rollback","approval_endpoint":"POST /api/proposals/{proposal_id}/decision","input":{"type":"object","required":["proposal_id","reason"],"properties":{"proposal_id":{"type":"string","format":"uuid"},"reason":{"type":"string","minLength":5,"maxLength":2000}},"additionalProperties":false},"output":{"$ref":"#/$defs/pendingProposal"}},
    {"name":"update_project_policy","status":"implemented-approval-gated","endpoint":"POST /api/policies then POST /api/proposals/{proposal_id}/decision","input":{"type":"object","required":["project_id","rule"],"properties":{"project_id":{"type":"string","format":"uuid"},"rule":{"type":"string","minLength":5,"maxLength":2000},"rationale":{"type":["string","null"],"maxLength":2000}},"additionalProperties":false},"output":{"type":"object","required":["proposal_id","status","active","enforcement_preview"],"properties":{"proposal_id":{"type":"string","format":"uuid"},"status":{"const":"pending"},"active":{"const":false},"enforcement_preview":{"type":"object"}}}},
    {"name":"compile_latex","status":"implemented","endpoint":"POST /api/projects/{project_id}/compile-plan then approval and POST /api/experiments","input":{"type":"object","required":["project_id"],"properties":{"project_id":{"type":"string","format":"uuid"}},"additionalProperties":false},"output":{"$ref":"#/$defs/pendingProposal"}}
  ],
  "$defs": {
    "attachment":{"type":"object","required":["name"],"properties":{"name":{"type":"string"},"artifact_id":{"type":["string","null"],"format":"uuid"}},"additionalProperties":false},
    "projectId":{"type":"object","required":["project_id"],"properties":{"project_id":{"type":"string","format":"uuid"}},"additionalProperties":false},
    "modelTier":{"type":"object","required":["model","url","key","reasoning_effort"],"properties":{"model":{"type":"string","minLength":1,"maxLength":200},"url":{"type":"string","format":"uri","pattern":"^https://"},"key":{"type":"string","maxLength":1000},"reasoning_effort":{"enum":["low","medium","high"]}},"additionalProperties":false},
    "chatResponse":{"type":"object","required":["session_id","phase","reply","missing_fields","clarification_mode"],"properties":{"session_id":{"type":"string","format":"uuid"},"project_id":{"type":["string","null"],"format":"uuid"},"phase":{"type":"string"},"reply":{"type":"string"},"spec":{"type":["object","null"]},"missing_fields":{"type":"array","items":{"type":"string"}},"action_required":{"type":["string","null"]},"model_tier":{"type":["string","null"],"enum":["simple","medium","complex",null]},"model":{"type":["string","null"]},"reasoning_effort":{"type":["string","null"]},"clarification_mode":{"type":"string","enum":["automatic","detailed"]}}},
    "repository":{"type":"object","required":["url","commit","license","paper_id","retrieved_at","verified_official"],"properties":{"url":{"type":"string","format":"uri"},"commit":{"type":"string"},"license":{"type":["string","null"]},"paper_id":{"type":"string","format":"uuid"},"retrieved_at":{"type":"string","format":"date-time"},"verified_official":{"type":"boolean"}}},
    "pendingProposal":{"type":"object","required":["proposal_id","status"],"properties":{"proposal_id":{"type":"string","format":"uuid"},"status":{"const":"pending"},"plan":{"type":"object"},"impact":{"type":"object"}}},
    "experimentPlan":{"type":"object","required":["schema_version","plan_type","project_id","idea_version","research_question","objective","source_evidence_ids","policy_ids","data_sources","baselines","metrics","ablations","statistical_tests","random_seeds","resource_budget","risks","success_criteria"],"properties":{"schema_version":{"const":"1.0"},"plan_type":{"const":"topic_specific"},"project_id":{"type":"string","format":"uuid"},"idea_version":{"type":"integer","minimum":1},"research_question":{"type":"string","minLength":10},"objective":{"type":"string","minLength":10},"source_evidence_ids":{"type":"array","minItems":1,"items":{"type":"string","format":"uuid"}},"policy_ids":{"type":"array","items":{"type":"string","format":"uuid"}},"data_sources":{"type":"array","minItems":1,"items":{"type":"object"}},"baselines":{"type":"array","minItems":1,"items":{"type":"object"}},"metrics":{"type":"array","minItems":1,"items":{"type":"object"}},"ablations":{"type":"array","minItems":1,"items":{"type":"object"}},"statistical_tests":{"type":"array","minItems":1,"items":{"type":"object"}},"random_seeds":{"type":"array","minItems":1,"maxItems":10,"items":{"type":"integer"}},"resource_budget":{"type":"object"},"risks":{"type":"array","minItems":1,"items":{"type":"object"}},"success_criteria":{"type":"array","minItems":1,"items":{"type":"object"}}},"additionalProperties":false},
    "experimentRequest":{"type":"object","required":["project_id","proposal_id","experiment_type"],"properties":{"project_id":{"type":"string","format":"uuid"},"proposal_id":{"type":"string","format":"uuid"},"experiment_type":{"enum":["topic_specific","demo_classification","point_cloud_demo","compile_latex","python_analysis","cpp_cmake","gpu_python","conda_python"]},"config":{"type":"object"},"random_seeds":{"type":"array","minItems":1,"maxItems":10,"items":{"type":"integer"}},"topic_plan":{"type":["object","null"]},"topic_resume":{"type":["object","null"]}},"allOf":[{"if":{"properties":{"experiment_type":{"const":"topic_specific"}},"required":["experiment_type"]},"then":{"required":["topic_plan"],"properties":{"config":{"maxProperties":0}}}},{"if":{"properties":{"experiment_type":{"const":"demo_classification"}}},"then":{"properties":{"config":{"$ref":"#/$defs/demoExperimentConfig"}}}},{"if":{"properties":{"experiment_type":{"enum":["point_cloud_demo","compile_latex"]}}},"then":{"properties":{"config":{"$ref":"#/$defs/simpleExperimentConfig"}}}},{"if":{"properties":{"experiment_type":{"enum":["python_analysis","gpu_python","conda_python"]}}},"then":{"properties":{"config":{"$ref":"#/$defs/pythonExperimentConfig"}}}},{"if":{"properties":{"experiment_type":{"const":"cpp_cmake"}}},"then":{"properties":{"config":{"$ref":"#/$defs/simpleExperimentConfig"}}}}],"additionalProperties":false},
    "demoExperimentConfig":{"type":"object","properties":{"n_samples":{"type":"integer","minimum":100,"maximum":100000},"n_features":{"type":"integer","minimum":2,"maximum":1000},"delay_seconds":{"type":"number","minimum":0,"maximum":10}},"additionalProperties":false},
    "simpleExperimentConfig":{"type":"object","properties":{"delay_seconds":{"type":"number","minimum":0,"maximum":10}},"additionalProperties":false},
    "pythonExperimentConfig":{"type":"object","properties":{"entrypoint":{"type":"string","pattern":"^experiment/[A-Za-z0-9_.-]+\\.py$"},"delay_seconds":{"type":"number","minimum":0,"maximum":10}},"additionalProperties":false},
    "runStatus":{"type":"object","required":["run_id","status","metrics","artifacts","reproducibility"],"properties":{"run_id":{"type":"string","format":"uuid"},"status":{"enum":["queued","running","succeeded","failed","cancelled"]},"metrics":{"type":"object"},"artifacts":{"type":"array"},"mlflow_run_id":{"type":["string","null"]},"error":{"type":["string","null"]},"reproducibility":{"type":["object","null"]}}},
    "changeProposal":{"type":"object","required":["project_id","kind","reason","summary"],"properties":{"project_id":{"type":"string","format":"uuid"},"kind":{"enum":["experiment_plan","code_patch","config_change","idea_revision","data_change","dependency_install","delete_artifact","external_publish"]},"reason":{"type":"string","minLength":5},"summary":{"type":"string","minLength":5},"diff":{"type":["string","null"]},"impact":{"type":"object"},"estimated_cost_usd":{"type":"number","minimum":0},"payload":{"type":"object"}},"additionalProperties":false},
    "patchOperation":{"type":"object","required":["action","path"],"properties":{"action":{"enum":["create","replace","delete"]},"path":{"type":"string","minLength":1,"maxLength":240,"pattern":"^[^\\\\/][^\\\\]*$"},"content":{"type":["string","null"],"maxLength":524288},"expected_sha256":{"type":["string","null"],"pattern":"^[0-9a-fA-F]{64}$"}},"additionalProperties":false}
  }
}
