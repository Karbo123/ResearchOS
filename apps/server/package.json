{
  "name": "@research-os/server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --no-file-parallelism",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.7",
    "@hono/node-server": "^2.0.12",
    "hono": "^4.12.32",
    "pdfjs-dist": "5.1.91",
    "supermemory": "^4.24.2",
    "tar": "7.5.9",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  }
}
