\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvpr}[2026/08/04 Research OS CVPR-style layout]
%
% Self-contained Research OS CVPR-style layout. It keeps the paper
% directory portable and compilable with a standard TeX distribution
% without requiring the upstream CVPR author-kit packages.
\RequirePackage{times}
\RequirePackage{xspace}
\RequirePackage{graphicx}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{booktabs}
\RequirePackage[table]{xcolor}
\RequirePackage[hyphens]{url}
\RequirePackage[margin=1in]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{caption}
\RequirePackage{subcaption}
%
\def\confName{CVPR}
\def\confYear{2026}
\def\paperID{0000}
%
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\confName~\confYear}
\fancyhead[R]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}
%
\renewcommand{\section}{\@startsection{section}{1}{\z@}{1.5ex \@plus .4ex \@minus .2ex}{0.8ex \@plus .2ex}{\normalfont\bfseries\small}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}{1.2ex \@plus .3ex \@minus .2ex}{0.5ex \@plus .2ex}{\normalfont\bfseries\footnotesize}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}{1.0ex \@plus .2ex \@minus .1ex}{0.4ex \@plus .1ex}{\normalfont\bfseries\footnotesize}}
%
\endinput
