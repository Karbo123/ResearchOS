{
  "name": "research-os-mastra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "mastra build --studio",
    "dev": "mastra dev",
    "start": "cross-env MASTRA_HOST=127.0.0.1 PORT=4111 MASTRA_STUDIO_PATH=.mastra/output/studio node .mastra/output/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mastra/core": "1.55.0",
    "@mastra/libsql": "1.18.0",
    "@mastra/memory": "1.24.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "cross-env": "7.0.3",
    "mastra": "1.21.0",
    "typescript": "5.8.3"
  }
}
