# Research OS local configuration template.
# Copy this file to .env, replace every placeholder, and never commit .env.
# The native TypeScript app persists embedded PostgreSQL-compatible state and
# controlled artifacts under these repository-relative directories.
RESEARCH_RUNTIME_DIR=runtime
RESEARCH_PROJECTS_DIR=projects
RESEARCH_ARTIFACTS_DIR=artifacts
RESEARCH_API_PORT=8080
MASTRA_BASE_URL=http://127.0.0.1:4111
MASTRA_STUDIO_URL=http://127.0.0.1:4111

# The in-process durable queue leases and dispatches only fixed Mastra workflows.
QUEUE_POLL_SECONDS=2
QUEUE_LEASE_SECONDS=180
QUEUE_WORKFLOW_TIMEOUT_SECONDS=90
QUEUE_RETRY_BASE_SECONDS=5
QUEUE_RETRY_MAX_SECONDS=300
RESEARCH_OS_COMMIT=unavailable

# Native experiment execution. Each Python project gets projects/<id>/.venv.
# The Linux backend (WSL2 native, default when the service runs in WSL2) uses
# python3; an explicitly selected Windows host backend uses python.exe.
RESEARCH_PYTHON_EXECUTABLE=python3
EXPERIMENT_TIMEOUT_SECONDS=3600

# The native Mastra process calls the configured OpenAI-compatible service. A failed
# request is returned as an API error; there is no provider switch, local reply,
# or unrelated experiment generation.
MODEL_REQUEST_TIMEOUT_SECONDS=240

# Project-scoped semantic memory through the locally hosted Supermemory server.
# Localhost requests may use Supermemory Local's automatic local authentication.
# Put an explicit local key here when using a non-loopback address or disabling
# automatic localhost authentication. All failures remain fail-closed.
SUPERMEMORY_ENABLED=true
SUPERMEMORY_BASE_URL=http://127.0.0.1:6767
SUPERMEMORY_API_KEY=
SUPERMEMORY_LOCAL_AUTO_AUTH=true
SUPERMEMORY_TIMEOUT_MS=30000
# Path to the official self-hosted supermemory-server executable used by
# `npm run supermemory:start`; leave empty when the service is managed outside
# this repository. Inside WSL2 this is a Linux path such as
# /home/<user>/bin/supermemory-server-linux-x64 (the official linux-x64
# 0.0.7-rc.2 release asset).
SUPERMEMORY_SERVER_BIN=

# Embedding provider for Supermemory Local. Official self-hosted docs define
# SUPERMEMORY_EMBEDDING_PROVIDER/MODEL/DIMENSIONS/BASE_URL; the bundled
# 0.0.7-rc.2 binary only implements the local ONNX worker, so keep provider=local
# unless a build that reads the remote variables is installed. Requesting remote
# embedding against an unsupported build fails closed instead of silently using
# local vectors. Changing dimensions requires a fresh data directory or a full
# re-ingestion.
SUPERMEMORY_EMBEDDING_PROVIDER=local
SUPERMEMORY_EMBEDDING_MODEL=Xenova/bge-base-en-v1.5
SUPERMEMORY_EMBEDDING_DIMENSIONS=768
SUPERMEMORY_EMBEDDING_BASE_URL=
SUPERMEMORY_EMBEDDING_API_KEY=

# Each tier is independent: model, URL, key, and reasoning effort. Plain HTTP is
# accepted only for loopback and RFC1918 private addresses.
# Non-empty web settings override these values; empty legacy runtime fields
# inherit the project .env defaults. Keys are written to ignored runtime/
# model-settings.json and never returned by the API.
RESEARCH_MODEL_SIMPLE=gpt-5.6-luna
RESEARCH_MODEL_URL_SIMPLE=http://127.0.0.1:3000/v1
RESEARCH_MODEL_KEY_SIMPLE=
RESEARCH_REASONING_SIMPLE=low
RESEARCH_MODEL_MEDIUM=gpt-5.6-terra
RESEARCH_MODEL_URL_MEDIUM=http://127.0.0.1:3000/v1
RESEARCH_MODEL_KEY_MEDIUM=
RESEARCH_REASONING_MEDIUM=medium
RESEARCH_MODEL_COMPLEX=gpt-5.6-sol
RESEARCH_MODEL_URL_COMPLEX=http://127.0.0.1:3000/v1
RESEARCH_MODEL_KEY_COMPLEX=
RESEARCH_REASONING_COMPLEX=high
RESEARCH_ROUTER_SIMPLE_MAX=2
RESEARCH_ROUTER_MEDIUM_MAX=7

# Optional academic/code-provider credentials. Empty values use public quotas.
# GitHub results remain unverified candidates until source/license cross-checking.
GITHUB_TOKEN=
GITLAB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=

# Mastra daily/weekly workflow schedule timezone.
REPORT_TIMEZONE=Asia/Shanghai

# Optional bounded health monitoring. HTTP alert URLs must be loopback/private;
# HTTPS alert URLs may be used for an explicitly configured external receiver.
RESEARCH_MONITOR_INTERVAL_SECONDS=30
RESEARCH_ALERT_WEBHOOK_URL=

# Upload security: the API invokes the fixed Windows Defender scanner through
# the native host path (Windows) or the WSL interop mount (/mnt/c) and fails
# closed when the scanner is unavailable, reports a threat, or times out.
WINDOWS_DEFENDER_EXECUTABLE=
MALWARE_SCAN_TIMEOUT_SECONDS=30
MATERIAL_MAX_FILE_BYTES=52428800
MATERIAL_MAX_SESSION_FILES=50
MATERIAL_MAX_SESSION_BYTES=262144000
MATERIAL_MAX_PROJECT_FILES=200
MATERIAL_MAX_PROJECT_BYTES=2147483648
