# Research OS local configuration template.
# Copy this file to .env, replace every placeholder, and never commit .env.
# Generate independent secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# PostgreSQL: changing these after postgres-data exists requires migration/restore.
POSTGRES_DB=research_os
POSTGRES_USER=research
POSTGRES_PASSWORD=change-me-to-a-unique-random-value

# MinIO: MLflow stores large artifacts in the private research-artifacts bucket.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-to-a-different-random-value

# n8n: keep the encryption key stable or stored n8n credentials may become unreadable.
# The local Owner is used server-side by /api/n8n/open for single-user Cookie login.
N8N_ENCRYPTION_KEY=replace-with-a-long-stable-random-value
N8N_LOCAL_OWNER_EMAIL=local-owner@research-os.invalid
N8N_LOCAL_OWNER_PASSWORD=replace-with-a-long-local-random-value

# Restricted API-to-Runner authentication and maximum allowlisted job duration.
RUNNER_SHARED_SECRET=replace-with-a-runner-only-random-value
RUNNER_MAX_SECONDS=600
# Pin these identities in a release deployment. Keep the explicit placeholder
# in local development rather than pretending a mutable local image is a digest.
RUNNER_IMAGE_DIGEST=unavailable
RESEARCH_OS_COMMIT=unavailable

# The API calls the configured OpenAI-compatible service directly from its
# container. A failed request is returned as an API error; there is no provider
# switch, local reply, or unrelated experiment generation.
RESEARCH_LLM_PROVIDER=openai
MODEL_REQUEST_TIMEOUT_SECONDS=240

# Each tier is independent: model, HTTPS URL, key, and reasoning effort.
# The web settings panel writes keys to ignored runtime/model-settings.json.
RESEARCH_MODEL_SIMPLE=gpt-5.6-luna
RESEARCH_MODEL_URL_SIMPLE=https://api.openai.com/v1
RESEARCH_MODEL_KEY_SIMPLE=
RESEARCH_REASONING_SIMPLE=low
RESEARCH_MODEL_MEDIUM=gpt-5.6-terra
RESEARCH_MODEL_URL_MEDIUM=https://api.openai.com/v1
RESEARCH_MODEL_KEY_MEDIUM=
RESEARCH_REASONING_MEDIUM=medium
RESEARCH_MODEL_COMPLEX=gpt-5.6-sol
RESEARCH_MODEL_URL_COMPLEX=https://api.openai.com/v1
RESEARCH_MODEL_KEY_COMPLEX=
RESEARCH_REASONING_COMPLEX=high
RESEARCH_ROUTER_SIMPLE_MAX=2
RESEARCH_ROUTER_MEDIUM_MAX=7

# Optional academic/code-provider credentials. Empty values use public quotas.
# GitHub results remain unverified candidates until source/license cross-checking.
GITHUB_TOKEN=
GITLAB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=

# n8n daily/weekly schedule timezone.
REPORT_TIMEZONE=Asia/Shanghai

# Do not start a Windows model service. The API container owns model requests.
